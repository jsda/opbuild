# OpenWrt 配置

## =========================
## 设备 / 平台
## =========================
CONFIG_TARGET_qualcommax=y                    # Qualcomm NSS 平台
CONFIG_TARGET_qualcommax_ipq60xx=y            # IPQ60xx SoC（如 IPQ6000/6010）
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y  # 京东云 RE-SS-01

## =========================
## jdcloud 调试
## =========================
# CONFIG_ATH11K_DEBUGFS_HTT_STATS is not set
# CONFIG_ATH11K_DEBUGFS_STA is not set
# CONFIG_ATH11K_THERMAL is not set             # 禁用降频

## jdcloud Wi-Fi 驱动
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
# immortalwrt
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set

## =========================
## jdcloud NSS（硬件加速核心）
## =========================
## NSS 构建参考
## https://github.com/JuliusBairaktaris/Qualcommax_NSS_Builder
CONFIG_ATH11K_NSS_SUPPORT=y                   # WiFi6 NSS 加速
CONFIG_ATH11K_NSS_MESH_SUPPORT=y              # Mesh NSS（实验性）
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y         # mac80211 NSS 支持

CONFIG_PACKAGE_kmod-qca-nss-drv=y             # NSS 主驱动
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y  # 桥接加速
CONFIG_PACKAGE_kmod-qca-nss-ecm=y             # NAT/连接跟踪加速（核心）
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y       # PPPoE 硬件加速
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y    # VLAN 硬件加速
CONFIG_PACKAGE_kmod-qca-mcs=y                 # 多核调度

CONFIG_NSS_FIRMWARE_VERSION_12_5=y            # NSS 固件版本（推荐）
CONFIG_PACKAGE_luci-mod-status-nss=y          # NSS 状态显示
# CONFIG_PACKAGE_sqm-scripts-nss is not set              # NSS QoS


## =========================
## 安全加固（编译级）
## =========================
CONFIG_GCC_DEFAULT_PIE=y                      # PIE（地址随机化）
CONFIG_GCC_DEFAULT_SSP=y                      # 栈保护
CONFIG_PKG_ASLR_PIE_ALL=y                     # 全局 ASLR
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y            # 所有包启用栈保护
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y      # 内核栈保护
CONFIG_PKG_RELRO_FULL=y                       # GOT 表保护

CONFIG_PKG_CHECK_FORMAT_SECURITY=y            # 格式化字符串检查
CONFIG_PKG_FORTIFY_SOURCE_3=y                 # 内存安全增强
CONFIG_USE_SECCOMP=y                          # syscall 限制


## =========================
## SSL / 加密
## =========================
CONFIG_LUA_ECO_OPENSSL=y                      # Lua 使用 OpenSSL
CONFIG_OPENSSL_OPTIMIZE_SPEED=y               # 优化性能
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-oqsprovider=y       # 后量子算法（可选）
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_LIBCURL_OPENSSL=y

## 禁用 mbedTLS（统一 OpenSSL）
# CONFIG_LUA_ECO_MBEDTLS is not set
# CONFIG_PACKAGE_apk-mbedtls is not set
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_LIBCURL_MBEDTLS is not set


## =========================
## Web 管理（LuCI）
## =========================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lua-runtime=y

## 界面模块
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y

## 中文
CONFIG_LUCI_LANG_zh_Hans=y

## 功能插件
CONFIG_PACKAGE_luci-app-base=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-uhttpd=y
# CONFIG_PACKAGE_luci-app-sqm is not set                 # SQM QoS
CONFIG_PACKAGE_luci-app-partexp=y             # 分区扩展
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-banip=y               # IP 黑名单
CONFIG_PACKAGE_luci-app-dockerman=y           # Docker
# CONFIG_PACKAGE_luci-app-diskman=y             # 磁盘管理
